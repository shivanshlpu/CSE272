# Backend-only credentials. Never commit a real .env file.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_BUDGET=1000
HOST=127.0.0.1
PORT=3001
# Required (24+ characters) when HOST exposes the service beyond loopback.
MONITOR_API_TOKEN=
# Set to your HTTPS frontend origin when deploying behind a reverse proxy.
APP_ORIGIN=
# Optional absolute path to Python; defaults to this project's .venv/bin/python.
# PYTHON_BIN=
# MONITOR_DB=/persistent-volume/monitoring.sqlite
